#| echo: false
#| message: false
#| warning: false
x5 <- seq(-8, 8, by = 0.05)
# Usamos suppressWarnings para evitar mensajes de R al calcular raíces negativas
y5 <- suppressWarnings(sqrt((x5 - 3) / (x5 + 1)))
# Nos aseguramos de limpiar el intervalo que no existe en el dominio
y5[x5 >= -1 & x5 < 3] <- NA
df5 <- data.frame(x = round(x5, 3), y = round(y5, 3))
hchart(df5, "line", hcaes(x = x, y = y), color = "#C0392B", name = "j(x)") %>%
hc_xAxis(title = list(text = "Dominio (x)"), crosshair = TRUE) %>%
hc_yAxis(title = list(text = "Rango j(x)"), min = 0, max = 4) %>%
hc_tooltip(headerFormat = "", pointFormat = "<b>X (Dominio):</b> {point.x} <br> <b>Y (Rango):</b> {point.y}")
#| label: fig-limite-e
#| fig-cap: "Convergencia de la función hacia el número e (≈ 2.718)"
#| fig-width: 7
#| fig-height: 4.5
library(ggplot2)
x_vals <- seq(1, 100, length.out = 400)
df_e <- data.frame(x = x_vals, y = (1 + 1/x_vals)^x_vals)
ggplot(df_e, aes(x = x, y = y)) +
geom_line(color = "#2980B9", linewidth = 1.2) +
geom_hline(yintercept = exp(1), linetype = "dashed", color = "#E74C3C", linewidth = 1) +
annotate("text", x = 80, y = 2.8, label = "Asíntota y = e", color = "#E74C3C", fontface = "bold") +
theme_minimal(base_size = 14) +
labs(x = "x", y = "f(x)")
#| label: setup
#| echo: false
#| message: false
#| warning: false
x_vals <- seq(1, 100, length.out = 400)
df_e <- data.frame(x = round(x_vals, 2), y = round((1 + 1/x_vals)^x_vals, 4))
hchart(df_e, "line", hcaes(x = x, y = y), color = "#2980B9", name = "f(x)") %>%
hc_yAxis(
title = list(text = "f(x)"),
plotLines = list(
list(value = exp(1), color = "#E74C3C", width = 2, dashStyle = "Dash",
label = list(text = "Asíntota y = e", align = "right"))
)
) %>%
hc_xAxis(title = list(text = "x"), crosshair = TRUE) %>%
hc_tooltip(headerFormat = "", pointFormat = "<b>x:</b> {point.x} <br> <b>f(x):</b> {point.y}")
