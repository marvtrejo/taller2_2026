#| warning: false
x2 <- seq(-2, 8, by = 0.05)
y2 <- sqrt(x2^2 - 6*x2 + 5)
# Los valores entre 1 y 5 no existen en los números reales
y2[x2 > 1 & x2 < 5] <- NA
df2 <- data.frame(x = round(x2, 3), y = round(y2, 3))
hchart(df2, "line", hcaes(x = x, y = y), color = "#27AE60", name = "g(x)") %>%
hc_xAxis(title = list(text = "Dominio (x)"), crosshair = TRUE) %>%
hc_yAxis(title = list(text = "Rango g(x)")) %>%
hc_tooltip(headerFormat = "", pointFormat = "<b>X (Dominio):</b> {point.x} <br> <b>Y (Rango):</b> {point.y}")
