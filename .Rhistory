library(rvest)
install.packages("xml2")
library(rvest)
# URL de la normateca
url <- "https://www.conavi.gob.mx/gobmx/normateca/"
# Leer el código HTML de la página
pagina <- read_html(url)
# Extraer todos los enlaces (etiquetas 'a' y su atributo 'href')
enlaces <- pagina %>%
html_nodes("a") %>%
html_attr("href")
# Filtrar solo los enlaces que terminan en .pdf (o .doc/.docx si fuera el caso)
enlaces_docs <- enlaces[grepl("\\.pdf$", enlaces, ignore.case = TRUE)]
# Completar los enlaces si son relativos
enlaces_completos <- url_absolute(enlaces_docs, url)
# Crear una carpeta temporal para las descargas
dir.create("documentos_conavi", showWarnings = FALSE)
# Bucle para descargar cada archivo
for (enlace in enlaces_completos) {
nombre_archivo <- file.path("documentos_conavi", basename(enlace))
# Descargar el archivo
try(download.file(enlace, destfile = nombre_archivo, mode = "wb", quiet = TRUE))
}
# Comprimir la carpeta en un archivo ZIP
archivos_descargados <- list.files("documentos_conavi", full.names = TRUE)
zip(zipfile = "Normateca_CONAVI.zip", files = archivos_descargados)
message("¡Proceso completado con éxito!")
library(rvest)
library(rvest)
library(httr)
url <- "https://www.conavi.gob.mx/gobmx/normateca/"
# 1. Leer la página
pagina <- read_html(url)
# 2. Extraer enlaces
enlaces <- pagina %>%
html_nodes("a") %>%
html_attr("href")
# 3. Filtrar PDFs (usamos una expresión más flexible por si hay mayúsculas)
enlaces_docs <- enlaces[grepl("\\.pdf$", enlaces, ignore.case = TRUE)]
enlaces_docs <- na.omit(enlaces_docs) # Eliminar posibles valores nulos
# --- PUNTO DE CONTROL 1 ---
if (length(enlaces_docs) == 0) {
stop("No se encontraron enlaces a archivos PDF. Es posible que la estructura de la página haya cambiado.")
} else {
message(paste("Se encontraron", length(enlaces_docs), "enlaces PDF."))
}
