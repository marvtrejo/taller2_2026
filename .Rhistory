x4 <- seq(-8, 6, by = 0.05)
y4 <- abs(x4) / (x4 + 2)
# Insertamos NA en la asíntota
y4[abs(x4 + 2) < 0.06] <- NA
df4 <- data.frame(x = round(x4, 3), y = round(y4, 3))
hchart(df4, "line", hcaes(x = x, y = y), color = "#E67E22", name = "i(x)") %>%
