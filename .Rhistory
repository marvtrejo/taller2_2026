#| label: fig-limite-seno
#| fig-cap: "Comportamiento de f(x) = sin(x)/x alrededor de x = 0"
library(ggplot2)
install.packages("ggplot2")
#| label: fig-limite-seno
#| fig-cap: "Comportamiento de f(x) = sin(x)/x alrededor de x = 0"
library(ggplot2)
x_vals <- seq(-10, 10, length.out = 400)
# Evitamos el 0 exacto para no generar un NA en R
x_vals <- x_vals[x_vals != 0]
y_vals <- sin(x_vals) / x_vals
df <- data.frame(x = x_vals, y = y_vals)
ggplot(df, aes(x = x, y = y)) +
geom_line(color = "blue", linewidth = 1) +
geom_point(aes(x = 0, y = 1), shape = 1, size = 3, color = "red") +
theme_minimal() +
labs(x = "x", y = "f(x)") +
geom_hline(yintercept = 1, linetype = "dashed", color = "gray") +
geom_vline(xintercept = 0, color = "black")
#| echo: false
#| label: tbl-funcion
#| tbl-cap: "Evaluación de la función f(x) = x^2 + 4"
# Creamos un vector con los valores de x
x <- -3:3
# Evaluamos la función
f_x <- x^2 + 4
# Creamos un data frame y mostramos la tabla
tabla_valores <- data.frame(x = x, `f(x)` = f_x, check.names = FALSE)
knitr::kable(tabla_valores, align = "c")
#| echo: false
#| message: false
#| warning: false
#| label: tbl-parabola
#| tbl-cap: "Valores de f(x)"
# Cargar las librerías necesarias
library(knitr)
library(kableExtra)
install.packages(kableExtra)
install.packages("kableExtra")
#| echo: false
#| message: false
#| warning: false
#| label: tbl-parabola
#| tbl-cap: "Valores de f(x)"
# Cargar las librerías necesarias
library(knitr)
library(kableExtra)
# Crear los datos
x_vals <- -3:3
fx_vals <- x_vals^2 + 4
df <- data.frame(x = x_vals, `f(x)` = fx_vals, check.names = FALSE)
# Generar la tabla con kableExtra
kable(df, align = "c", format = "html") %>%
kable_styling(bootstrap_options = c("striped", "hover", "condensed"), full_width = FALSE) %>%
# Resaltar la fila donde x = 3 (que es la fila 7)
row_spec(7, bold = TRUE, color = "black", background = "#FFDDC1")
#| echo: false
#| message: false
#| warning: false
#| label: fig-parabola
#| fig-cap: "Comportamiento de la parábola"
#| fig-width: 5
#| fig-height: 4
library(ggplot2)
# Crear la gráfica
ggplot(data.frame(x = c(-3.5, 3.5)), aes(x = x)) +
stat_function(fun = function(x) x^2 + 4, color = "#2C3E50", linewidth = 1) +
# Resaltar el punto x=3
geom_point(aes(x = 3, y = 13), color = "#E67E22", size = 3) +
annotate("text", x = 3, y = 14.5, label = "(3, 13)", color = "#E67E22", fontface = "bold") +
theme_minimal() +
labs(x = "x", y = "f(x)")
#| echo: false
#| message: false
#| warning: false
#| label: fig-funcion-raiz
#| fig-cap: "Evaluación de la función f(x) = √(x - 2)"
#| fig-width: 7
#| fig-height: 5.5
library(ggplot2)
# Definimos el dominio válido para la gráfica (x >= 2)
x_vals <- seq(2, 7, length.out = 300)
df <- data.frame(x = x_vals, y = sqrt(x_vals - 2))
ggplot(df, aes(x = x, y = y)) +
# Trazamos la línea de la función
geom_line(color = "#2C3E50", linewidth = 1.2) +
# Resaltar f(3)
geom_point(aes(x = 3, y = 1), color = "#E67E22", size = 4) +
annotate("text", x = 3, y = 1.15, label = "(3, 1)", color = "#E67E22", fontface = "bold", size = 5) +
# Resaltar f(5)
geom_point(aes(x = 5, y = sqrt(3)), color = "#E67E22", size = 4) +
# Usamos el símbolo unicode para la raíz cuadrada (√) en la etiqueta
annotate("text", x = 5, y = sqrt(3) + 0.15, label = "(5, \u221A3)", color = "#E67E22", fontface = "bold", size = 5) +
theme_minimal(base_size = 16) +
labs(x = "x", y = "f(x)")
#| echo: false
#| message: false
#| warning: false
#| label: fig-funcion-precio
#| fig-cap: "Evaluación de la función de precio p(q) = -0.4q + 25"
#| fig-width: 7
#| fig-height: 5.5
library(ggplot2)
ggplot(data.frame(q = c(0, 70)), aes(x = q)) +
stat_function(fun = function(q) -(4/10)*q + 25, color = "#2C3E50", linewidth = 1.2) +
geom_point(aes(x = 10, y = 21), color = "#E67E22", size = 4) +
annotate("text", x = 14, y = 22.5, label = "(10, 21)", color = "#E67E22", fontface = "bold", size = 5) +
theme_minimal(base_size = 16) +
labs(x = "Cantidad (q)", y = "Precio p(q)")
#| label: fig-seno-coseno
#| fig-cap: "Comportamiento de las funciones seno y coseno limitadas entre -1 y 1"
#| fig-width: 7
#| fig-height: 4.5
library(ggplot2)
x_vals <- seq(-2*pi, 2*pi, length.out = 400)
df <- data.frame(
x = rep(x_vals, 2),
y = c(sin(x_vals), cos(x_vals)),
funcion = rep(c("sen(x)", "cos(x)"), each = 400)
)
ggplot(df, aes(x = x, y = y, color = funcion)) +
geom_line(linewidth = 1) +
geom_hline(yintercept = c(-1, 1), linetype = "dashed", color = "black") +
scale_color_manual(values = c("#2980B9", "#E67E22")) +
theme_minimal(base_size = 14) +
labs(x = "x (radianes)", y = "f(x)") +
scale_x_continuous(breaks = c(-2*pi, -pi, 0, pi, 2*pi),
labels = c("-2π", "-π", "0", "π", "2π"))
install.packages(c("highcharter", "dplyr"))
#| label: setup
#| echo: false
library(highcharter)
#| label: fig-f1
#| fig-cap: "Gráfica interactiva de f(x)"
x1 <- seq(-6, 6, by = 0.05)
y1 <- (x1 - 1) / (x1^2 - 4)
# Insertamos NA para evitar que se conecten los puntos en las asíntotas
y1[abs(x1 - 2) < 0.06 | abs(x1 + 2) < 0.06] <- NA
df1 <- data.frame(x = round(x1, 3), y = round(y1, 3))
hchart(df1, "line", hcaes(x = x, y = y), color = "#2980B9", name = "f(x)") %>%
hc_xAxis(title = list(text = "Dominio (x)"), crosshair = TRUE) %>%
hc_yAxis(title = list(text = "Rango f(x)"), min = -10, max = 10) %>%
hc_tooltip(headerFormat = "", pointFormat = "<b>X (Dominio):</b> {point.x} <br> <b>Y (Rango):</b> {point.y}")
