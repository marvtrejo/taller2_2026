library(highcharter)
library(knitr)
library(kableExtra)
library(dplyr)
library(ggplot2)
#| echo: false
#| message: false
#| warning: false
x_hc <- seq(-3, 3, by = 0.05)
y_hc <- sqrt(9 - x_hc^2)
df_hc <- data.frame(x = round(x_hc, 2), y = round(y_hc, 2))
hchart(df_hc, "line", hcaes(x = x, y = y), color = "#27AE60", name = "f(x)") %>%
hc_plotOptions(line = list(lineWidth = 3)) %>%
hc_xAxis(title = list(text = "x"), crosshair = TRUE) %>%
hc_yAxis(title = list(text = "f(x)"), min = 0, max = 4) %>%
hc_tooltip(pointFormat = "<b>f(x):</b> {point.y}")
#| echo: false
#| message: false
#| warning: false
x_hc <- seq(-5, 5, by = 0.05)
y_hc <- sqrt(5 - x_hc)
df_hc <- data.frame(x = round(x_hc, 2), y = round(y_hc, 2))
hchart(df_hc, "line", hcaes(x = x, y = y), color = "#16A085", name = "f(x)") %>%
hc_plotOptions(line = list(lineWidth = 3)) %>% # <--- Línea agregada
hc_xAxis(title = list(text = "x"), crosshair = TRUE) %>%
hc_yAxis(title = list(text = "f(x)")) %>%
hc_tooltip(pointFormat = "<b>f(x):</b> {point.y}")
#| echo: false
#| message: false
#| warning: false
x_hc <- seq(-6, 6, by = 0.05)
y_hc <- sqrt(x_hc^2 - 4)
y_hc[x_hc > -2 & x_hc < 2] <- NA
df_hc <- data.frame(x = round(x_hc, 2), y = round(y_hc, 2))
hchart(df_hc, "line", hcaes(x = x, y = y), color = "#D35400", name = "f(x)") %>%
hc_plotOptions(line = list(lineWidth = 3)) %>% # <--- Línea agregada
hc_xAxis(title = list(text = "x"), crosshair = TRUE) %>%
hc_yAxis(title = list(text = "f(x)"), min = 0, max = 6) %>%
hc_tooltip(pointFormat = "<b>f(x):</b> {point.y}")
