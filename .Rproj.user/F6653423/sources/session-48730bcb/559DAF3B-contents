## Ejemplos de funciones

### 1. $f(x) = x^2 - 4$

* **Dominio:** $x \in \mathbb{R}$ o $(-\infty, \infty)$
* **Rango:** $\{y \in \mathbb{R} \mid y \ge -4\}$ o $[-4, \infty)$

::: {layout-ncol=2 style="display: flex; align-items: center;"}

```{r}
#| echo: false
#| message: false
#| warning: false
x_vals <- -3:3
y_vals <- x_vals^2 - 4
df_tbl <- data.frame(x = x_vals, `f(x)` = y_vals, check.names = FALSE)

kable(df_tbl, align = "c") %>%
  kable_styling(bootstrap_options = c("striped", "hover", "condensed"), full_width = FALSE)
```


```{r}
#| echo: false
#| message: false
#| warning: false

x_hc <- seq(-4, 4, by = 0.1)
df_hc <- data.frame(x = round(x_hc, 2), y = round(x_hc^2 - 4, 2))

hchart(df_hc, "line", hcaes(x = x, y = y), color = "#2980B9", name = "f(x)") %>%
  hc_xAxis(title = list(text = "x"), crosshair = TRUE) %>%
  hc_yAxis(title = list(text = "f(x)")) %>%
  hc_tooltip(pointFormat = "<b>f(x):</b> {point.y}")
```
:::

---

### 2. $f(x) = \frac{1}{x+3}$

* **Dominio:** $\{x \in \mathbb{R} \mid x \neq -3\}$ o $(-\infty, -3) \cup (-3, \infty)$
* **Rango:** $\{y \in \mathbb{R} \mid y \neq 0\}$

::: {layout-ncol=2 style="display: flex; align-items: center;"}

```{r}
#| echo: false
#| message: false
#| warning: false

x_vals <- -6:0
y_vals <- round(1 / (x_vals + 3), 2)
y_vals[is.infinite(y_vals)] <- "Indefinido"
df_tbl <- data.frame(x = x_vals, `f(x)` = y_vals, check.names = FALSE)

kable(df_tbl, align = "c") %>%
  kable_styling(bootstrap_options = c("striped", "hover", "condensed"), full_width = FALSE) %>%
  row_spec(4, bold = TRUE, color = "white", background = "#E74C3C")
```

```{r}
#| echo: false
#| message: false
#| warning: false

x_hc <- seq(-8, 2, by = 0.05)
y_hc <- 1 / (x_hc + 3)
y_hc[abs(x_hc + 3) < 0.1] <- NA
df_hc <- data.frame(x = round(x_hc, 2), y = round(y_hc, 2))

hchart(df_hc, "line", hcaes(x = x, y = y), color = "#8E44AD", name = "f(x)") %>%
  hc_xAxis(title = list(text = "x"), crosshair = TRUE) %>%
  hc_yAxis(title = list(text = "f(x)"), min = -10, max = 10) %>%
  hc_tooltip(pointFormat = "<b>f(x):</b> {point.y}")
```
:::

