### 3. $f(x) = \sqrt{9-x^2}$

* **Dominio:** $9-x^2 \ge 0 \implies (3-x)(3+x) \ge 0 \implies -3 \le x \le 3$. Dominio: $[-3, 3]$
* **Rango:** $[0, 3]$

::: {layout-ncol=2 style="display: flex; align-items: center;"}

```{r}
#| echo: false
#| message: false
#| warning: false

x_vals <- -4:4
y_vals <- suppressWarnings(sqrt(9 - x_vals^2))
y_vals <- ifelse(is.nan(y_vals), "No Real", round(y_vals, 2))
df_tbl <- data.frame(x = x_vals, `f(x)` = y_vals, check.names = FALSE)

kable(df_tbl, align = "c") %>%
  kable_styling(bootstrap_options = c("striped", "hover", "condensed"), full_width = FALSE)
```

```{r}
#| echo: false
#| message: false
#| warning: false

x_hc <- seq(-3, 3, by = 0.05)
y_hc <- sqrt(9 - x_hc^2)
df_hc <- data.frame(x = round(x_hc, 2), y = round(y_hc, 2))

hchart(df_hc, "line", hcaes(x = x, y = y), color = "#27AE60", name = "f(x)") %>%
  hc_plotOptions(line = list(lineWidth = 3)) %>% 
  hc_xAxis(title = list(text = "x"), crosshair = TRUE) %>%
  hc_yAxis(title = list(text = "f(x)"), min = 0, max = 4) %>%
  hc_tooltip(pointFormat = "<b>f(x):</b> {point.y}")
```
:::

