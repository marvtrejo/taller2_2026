**Para una función de precio $p(q) = -\frac{4}{10} q + 25$, calcula:**

$$
\text{1) } p(10) \\
$$

$$
\begin{aligned}
p(10) &= -\frac{4}{10} (10) + 25\\
p(10) &= -\frac{4(10)}{10} + 25=-4+25\\
p(10) &= 21
\\
\\
\end{aligned}
$$

::: {style="text-align: center;"}
**Ejercicio 2. $p(q) = -\frac{4}{10} q + 25$**

```{r}
#| echo: false
#| message: false
#| warning: false
#| fig-width: 7
#| fig-height: 5.5

library(ggplot2)

ggplot(data.frame(q = c(0, 70)), aes(x = q)) +

  stat_function(fun = function(q) -(4/10)*q + 25, color = "#2C3E50", linewidth = 1.2) +
  
  geom_point(aes(x = 10, y = 21), color = "#E67E22", size = 4) +
  
  annotate("text", x = 14, y = 22.5, label = "(10, 21)", color = "#E67E22", fontface = "bold", size = 5) +
  
  theme_minimal(base_size = 16) +
  labs(x = "Cantidad (q)", y = "Precio p(q)")

```
