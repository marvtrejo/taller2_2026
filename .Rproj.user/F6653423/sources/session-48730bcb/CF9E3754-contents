#| echo: false
#| fig-cap: "Recta secante que pasa por los puntos P y Q"

df_pendiente <- data.frame(
  x = c(1, 5),
  y = c(4, 6),
  point_label = c("P(1, 4)", "Q(5, 6)")
)

hchart(df_pendiente, "scatter", hcaes(x = x, y = y), color = "#2980B9", name = "Puntos P y Q", marker = list(radius = 7)) %>%
  hc_add_series(data = df_pendiente, type = "line", hcaes(x = x, y = y), color = "#27AE60", name = "Recta secante m = 1/2", lineWidth = 2) %>%
  hc_plotOptions(scatter = list(dataLabels = list(enabled = TRUE, format = "{point.point_label}", style = list(color = "#333", fontSize = "13px")))) %>%
  hc_xAxis(title = list(text = "Eje X"), crosshair = TRUE, min = 0, max = 6, breaks = seq(0, 6, 1)) %>%
  hc_yAxis(title = list(text = "Eje Y"), min = 0, max = 8, breaks = seq(0, 8, 1)) %>%
  hc_tooltip(pointFormat = "<b>({point.x}, {point.y})</b>")
```

